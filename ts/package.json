{
  "name": "panopticode-ts",
  "version": "0.3.0",
  "description": "Visual explanations of TypeScript codebase health",
  "type": "module",
  "license": "MIT",
  "bin": {
    "panopticode-ts": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-web.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node dist/cli.js examples/demo --out reports/demo --coverage examples/demo/coverage.json --eslint examples/demo/eslint.json",
    "self": "npm run build && node dist/cli.js . --name panopticode-ts --out reports/self",
    "lint": "npm run build && eslint src",
    "test:coverage": "c8 node --test test/*.test.mjs"
  },
  "dependencies": {
    "@eslint/js": "9.39.5",
    "@jscpd/core": "4.0.1",
    "@jscpd/tokenizer": "4.0.1",
    "c8": "10.1.3",
    "dependency-cruiser": "17.4.3",
    "eslint": "9.39.5",
    "eslint-plugin-sonarjs": "1.0.4",
    "globals": "16.5.0",
    "knip": "5.88.1",
    "ts-morph": "27.0.2",
    "typescript-eslint": "8.72.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
