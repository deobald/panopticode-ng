<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>panopticode-csharp</AssemblyName>
    <Version>0.1.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>panopticode-csharp</ToolCommandName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Offline C# code health and hardening evidence.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.322" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="5.6.0" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <EmbeddedResource Include="Web/*" />
    <None Include="../README.md" Pack="true" PackagePath="/README.md" />
    <None Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="../../ts/src/web/treemap.js" LogicalName="Panopticode.CSharp.Web.treemap.js" />
    <None Include="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)/analyzers/dotnet/cs/*.dll" Link="Analyzers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="$(PkgMeziantou_Analyzer)/analyzers/dotnet/roslyn5.9/cs/Meziantou.Analyzer.dll" Link="Analyzers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Reference Include="Metrics"><HintPath>$(PkgMicrosoft_CodeAnalysis_Metrics)/Metrics/Metrics.exe</HintPath><Private>true</Private><Aliases>metrics</Aliases></Reference>
    <Reference Include="Microsoft.CodeAnalysis.AnalyzerUtilities"><HintPath>$(PkgMicrosoft_CodeAnalysis_Metrics)/Metrics/Microsoft.CodeAnalysis.AnalyzerUtilities.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- These packages are runtime inputs to our diagnostic host, not an implicit
       development style policy. The CLI runs its explicit baseline separately. -->
  <Target Name="RemoveBundledAnalyzerBuildPolicy" BeforeTargets="CoreCompile">
    <ItemGroup><Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Meziantou.Analyzer'" /></ItemGroup>
  </Target>
</Project>
